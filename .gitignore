build/
dist/

# Everything under data/ is generated by `python -m modelops demo`:
# the synthetic source models, the SQLite catalog, the work area and the
# published deliverables. None of it is source, and a hosted deploy
# regenerates it on boot.
data/

# Local scratch: screenshots taken by scripts/shoot.ps1 and the server logs
# from a backgrounded `modelops serve`. Useful while working, not source.
shots/
*.log
serve.err

.DS_Store
Thumbs.db
