{
  "pipeline_version": "1.4.0",

  "paths": {
    "root": "data",
    "inbox": "data/inbox",
    "work": "data/work",
    "published": "data/published",
    "quarantine": "data/quarantine",
    "outbox": "data/outbox",
    "catalog_db": "data/catalog.db",
    "logs": "data/logs"
  },

  "orchestrator": {
    "worker_count": 4,
    "max_attempts": 3,
    "backoff_base_seconds": 2,
    "backoff_max_seconds": 60,
    "job_sla_minutes": 20,
    "stage_timeout_seconds": 900,
    "poll_interval_seconds": 2
  },

  "validation": {
    "required_manifest_fields": [
      "project_code",
      "model_key",
      "model_name",
      "discipline",
      "source_tool",
      "revision_label",
      "unit_system",
      "coordinate_system"
    ],
    "allowed_unit_systems": ["mm", "m", "in", "ft"],
    "allowed_disciplines": ["PIPING", "STRUCTURAL", "ELECTRICAL", "HVAC", "EQUIPMENT", "CIVIL"],
    "tag_pattern": "^[0-9]{2}-[A-Z]{1,3}-[0-9]{3,5}(-[A-Z0-9\\.\"]+)*$",
    "required_attributes": ["System", "Area", "Material", "CommissioningSystem"],
    "max_components": 250000,
    "max_source_mb": 512
  },

  "optimize": {
    "weld_tolerance": 1e-5,
    "instance_dedupe": true,
    "lod_levels": [
      { "name": "LOD0", "target_ratio": 1.0 },
      { "name": "LOD1", "target_ratio": 0.45 },
      { "name": "LOD2", "target_ratio": 0.15 }
    ],
    "min_faces_to_decimate": 64,
    "lod_min_rendered_triangles": 20000
  },

  "qa_gates": {
    "bbox_drift_tolerance_pct": 1.0,
    "volume_drift_tolerance_pct": 3.0,
    "lod_volume_drift_tolerance_pct": 15.0,
    "min_tag_coverage_pct": 95.0,
    "min_attribute_coverage_pct": 90.0,
    "max_untagged_geometry_pct": 5.0,
    "fail_on_severity": "ERROR"
  },

  "alerting": {
    "cooldown_minutes": 15,
    "sink": "data/logs/alert_webhook.jsonl",
    "rules": {
      "consecutive_failures_threshold": 2,
      "success_rate_window_hours": 24,
      "min_success_rate_pct": 90.0,
      "stage_p95_seconds_threshold": 45,
      "stale_model_hours": 168
    }
  },

  "delivery": {
    "viewer_target": "UniversalPlantViewer",
    "keep_revisions": 5,
    "emit_cde_manifest": true
  }
}
